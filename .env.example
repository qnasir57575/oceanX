# Copy to .env.local (Next.js) and .env (Prisma CLI / scripts):
#   cp .env.example .env.local && cp .env.example .env
# Never commit real secrets. Variables prefixed NEXT_PUBLIC_ are exposed to the browser.

# ─── Frontend / API client ──────────────────────────────────────────────────
# Base path or URL of the API. Default "/api/v1" = same origin as the Next.js app.
NEXT_PUBLIC_API_BASE_URL="/api/v1"

# Origin used by *server-side* code (Server Components, route handlers) when
# NEXT_PUBLIC_API_BASE_URL is relative. Not exposed to the browser.
API_INTERNAL_ORIGIN="http://localhost:3000"

# Mock API (development only). When "true", every function in src/lib/api/*
# is served by src/mocks instead of the backend. Production builds FAIL if this
# is "true" (see next.config.ts), and the runtime ignores it in production.
NEXT_PUBLIC_USE_MOCK_API="false"
# Artificial latency for mock responses, so loading states are visible.
NEXT_PUBLIC_MOCK_DELAY_MS="300"
# Global mock scenario: normal | empty | error | unauthenticated | slow
NEXT_PUBLIC_MOCK_SCENARIO="normal"
# Optional: start the mock session logged in as admin | editor | researcher | member
NEXT_PUBLIC_MOCK_USER=""
# In development, warn in the console when a live API response does not match
# the contract in src/contracts (helps detect backend/frontend drift).
NEXT_PUBLIC_VALIDATE_API_RESPONSES="true"

# ─── Database (backend) ─────────────────────────────────────────────────────
# Matches docker-compose.yml (npm run db:up).
DATABASE_URL="postgresql://oceanx:oceanx_dev_password@localhost:5434/oceanx?schema=public"
# Used only by contract tests (npm run test:contract). Tests wipe this database.
TEST_DATABASE_URL="postgresql://oceanx:oceanx_dev_password@localhost:5434/oceanx_test?schema=public"

# ─── Auth (backend) ─────────────────────────────────────────────────────────
# Public origin of the app. Used for the CSRF Origin check on state-changing requests.
APP_ORIGIN="http://localhost:3000"
# Session lifetime in days (httpOnly cookie "oceanx_session").
SESSION_TTL_DAYS="14"

# ─── File storage (backend) — PLANNED: upload endpoints not implemented yet ─
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage"
# S3-compatible driver (production):
# S3_BUCKET=""
# S3_REGION=""
# S3_ENDPOINT=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""

# ─── AI provider (backend) — PLANNED: AI endpoints not implemented yet ──────
# Server-only. Never prefix with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=""
AI_MODEL="claude-opus-5-5"
