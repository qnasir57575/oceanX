// OceanX Polar Science Portal — database schema.
// Owned by the backend. Frontend changes here require coordination (see CLAUDE.md).
//
// Conventions:
//  - IDs are opaque strings (cuid). Seeded demo data uses readable IDs like exp_demo_01.
//  - Content records carry `status` (editorial workflow) and soft-delete via status ARCHIVED.
//  - Enum values mirror src/contracts/primitives.ts — keep them identical.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ──────────────────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  EDITOR
  RESEARCHER
  MEMBER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum PolarRegion {
  ANTARCTICA
  ARCTIC
  HIMALAYA
  SOUTHERN_OCEAN
}

enum ContentStatus {
  DRAFT
  PENDING_REVIEW
  CHANGES_REQUESTED
  PUBLISHED
  REJECTED
  ARCHIVED
}

enum AccessLevel {
  OPEN
  REGISTERED
  RESTRICTED
}

enum ExpeditionPhase {
  PLANNED
  ONGOING
  COMPLETED
}

enum PublicationType {
  JOURNAL_ARTICLE
  CONFERENCE_PAPER
  REPORT
  THESIS
  BOOK_CHAPTER
  TECHNICAL_NOTE
  DATA_PAPER
  OTHER
}

enum MediaType {
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
}

enum ActivityType {
  NEWS
  EVENT
  PRESS_RELEASE
  OUTREACH_PROGRAM
  WORKSHOP
  ANNOUNCEMENT
}

enum UploadPurpose {
  PUBLICATION_PDF
  DATASET_FILE
  MEDIA
  COVER_IMAGE
  ATTACHMENT
  AVATAR
}

enum FileStatus {
  PENDING
  READY
  FAILED
}

enum ContentType {
  EXPEDITION
  PUBLICATION
  DATASET
  MEDIA
  ACTIVITY
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
  CHANGES_REQUESTED
  WITHDRAWN
}

enum ReviewAction {
  SUBMITTED
  APPROVED
  REJECTED
  CHANGES_REQUESTED
  WITHDRAWN
}

enum AIContentKind {
  RESEARCH_SUMMARY
  SOCIAL_POST
  NEWSLETTER
  PRESS_RELEASE
  EXPLAINER
  QUIZ
  FAQ
}

enum AIContentStatus {
  DRAFT
  PUBLISHED
  REJECTED
  ARCHIVED
}

enum Audience {
  GENERAL_PUBLIC
  STUDENTS
  EDUCATORS
  POLICY_MAKERS
  RESEARCHERS
}

// ─── Users & sessions ───────────────────────────────────────────────────────

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  name         String
  role         UserRole   @default(MEMBER)
  status       UserStatus @default(ACTIVE)
  affiliation  String?
  bio          String?
  avatarUrl    String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  lastLoginAt  DateTime?

  sessions      Session[]
  expeditions   Expedition[]   @relation("ExpeditionOwner")
  publications  Publication[]  @relation("PublicationOwner")
  datasets      Dataset[]      @relation("DatasetOwner")
  media         MediaAsset[]   @relation("MediaOwner")
  activities    Activity[]     @relation("ActivityOwner")
  files         FileAsset[]
  submissions   Submission[]   @relation("Submitter")
  reviews       Submission[]   @relation("Reviewer")
  reviewEvents  ReviewEvent[]
  aiGenerated   AIContent[]    @relation("AIGeneratedBy")
  aiReviewed    AIContent[]    @relation("AIReviewedBy")
  auditLogs     AuditLog[]
  passwordResets PasswordResetToken[]
}

model Session {
  id         String   @id @default(cuid())
  /// SHA-256 of the cookie token. The raw token is never stored.
  tokenHash  String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())
  userAgent  String?
  ipAddress  String?

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ─── Taxonomy ───────────────────────────────────────────────────────────────

model Category {
  id          String     @id @default(cuid())
  slug        String     @unique
  name        String
  description String?
  parentId    String?
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children    Category[] @relation("CategoryTree")
  sortOrder   Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  expeditions  Expedition[]
  publications Publication[]
  datasets     Dataset[]
  media        MediaAsset[]
  activities   Activity[]
}

model Keyword {
  id        String   @id @default(cuid())
  slug      String   @unique
  label     String
  createdAt DateTime @default(now())

  expeditions  Expedition[]
  publications Publication[]
  datasets     Dataset[]
  media        MediaAsset[]
  activities   Activity[]
}

// ─── Content ────────────────────────────────────────────────────────────────

model Expedition {
  id               String          @id @default(cuid())
  slug             String          @unique
  title            String
  summary          String
  description      String
  region           PolarRegion
  phase            ExpeditionPhase @default(PLANNED)
  year             Int
  startDate        DateTime?       @db.Date
  endDate          DateTime?       @db.Date
  station          String?
  vessel           String?
  leadInstitution  String?
  chiefScientist   String?
  participantCount Int?
  objectives       String[]
  latitude         Float?
  longitude        Float?
  locationLabel    String?
  coverImageUrl    String?
  coverImageAlt    String?
  coverImageWidth  Int?
  coverImageHeight Int?
  coverImageCredit String?

  status      ContentStatus @default(DRAFT)
  publishedAt DateTime?
  ownerId     String?
  owner       User?         @relation("ExpeditionOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  categories   Category[]
  keywords     Keyword[]
  publications Publication[]
  datasets     Dataset[]
  media        MediaAsset[]

  @@index([status, region, year])
  @@index([status, publishedAt])
}

model Publication {
  id              String          @id @default(cuid())
  slug            String          @unique
  title           String
  abstract        String
  /// JSON array of { name, affiliation, orcid } in author order.
  authors         Json
  /// Lower-cased author names joined with " | " for search.
  authorsText     String          @default("")
  type            PublicationType
  year            Int
  publicationDate DateTime?       @db.Date
  venue           String?
  volume          String?
  issue           String?
  pages           String?
  publisher       String?
  doi             String?         @unique
  externalUrl     String?
  accessLevel     AccessLevel     @default(OPEN)
  region          PolarRegion?
  pdfFileId       String?         @unique
  pdfFile         FileAsset?      @relation("PublicationPdf", fields: [pdfFileId], references: [id], onDelete: SetNull)
  expeditionId    String?
  expedition      Expedition?     @relation(fields: [expeditionId], references: [id], onDelete: SetNull)

  status      ContentStatus @default(DRAFT)
  publishedAt DateTime?
  ownerId     String?
  owner       User?         @relation("PublicationOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  categories Category[]
  keywords   Keyword[]
  datasets   Dataset[]  @relation("DatasetPublications")

  @@index([status, year])
  @@index([status, type])
  @@index([expeditionId])
}

model Dataset {
  id                  String        @id @default(cuid())
  slug                String        @unique
  title               String
  summary             String
  description         String
  region              PolarRegion
  parameters          String[]
  formats             String[]
  temporalStart       DateTime?     @db.Date
  temporalEnd         DateTime?     @db.Date
  bboxWest            Float?
  bboxSouth           Float?
  bboxEast            Float?
  bboxNorth           Float?
  license             String
  doi                 String?       @unique
  version             String?
  accessLevel         AccessLevel   @default(OPEN)
  downloadCount       Int           @default(0)
  contactName         String?
  contactEmail        String?
  contactOrganization String?
  expeditionId        String?
  expedition          Expedition?   @relation(fields: [expeditionId], references: [id], onDelete: SetNull)

  status      ContentStatus @default(DRAFT)
  publishedAt DateTime?
  ownerId     String?
  owner       User?         @relation("DatasetOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  files        FileAsset[]   @relation("DatasetFiles")
  publications Publication[] @relation("DatasetPublications")
  categories   Category[]
  keywords     Keyword[]

  @@index([status, region])
  @@index([expeditionId])
}

model MediaAsset {
  id              String      @id @default(cuid())
  slug            String      @unique
  title           String
  type            MediaType
  url             String
  thumbnailUrl    String
  embedUrl        String?
  altText         String
  description     String?
  width           Int?
  height          Int?
  durationSeconds Int?
  credit          String?
  license         String?
  capturedAt      DateTime?   @db.Date
  latitude        Float?
  longitude       Float?
  locationLabel   String?
  featured        Boolean     @default(false)
  region          PolarRegion?
  fileId          String?
  file            FileAsset?  @relation("MediaFile", fields: [fileId], references: [id], onDelete: SetNull)
  expeditionId    String?
  expedition      Expedition? @relation(fields: [expeditionId], references: [id], onDelete: SetNull)

  status      ContentStatus @default(DRAFT)
  publishedAt DateTime?
  ownerId     String?
  owner       User?         @relation("MediaOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  categories Category[]
  keywords   Keyword[]

  @@index([status, type])
  @@index([status, featured])
  @@index([expeditionId])
}

model Activity {
  id               String       @id @default(cuid())
  slug             String       @unique
  type             ActivityType
  title            String
  summary          String
  body             String
  coverImageUrl    String?
  coverImageAlt    String?
  coverImageWidth  Int?
  coverImageHeight Int?
  coverImageCredit String?
  startsAt         DateTime?
  endsAt           DateTime?
  location         String?
  isOnline         Boolean      @default(false)
  registrationUrl  String?
  externalUrl      String?
  region           PolarRegion?

  status      ContentStatus @default(DRAFT)
  publishedAt DateTime?
  ownerId     String?
  owner       User?         @relation("ActivityOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  attachments FileAsset[] @relation("ActivityAttachments")
  categories  Category[]
  keywords    Keyword[]

  @@index([status, type])
  @@index([status, startsAt])
}

// ─── Files ──────────────────────────────────────────────────────────────────

model FileAsset {
  id             String        @id @default(cuid())
  storageKey     String        @unique
  fileName       String
  contentType    String
  /// BigInt: dataset files may exceed 2 GB.
  sizeBytes      BigInt
  checksumSha256 String?
  purpose        UploadPurpose
  accessLevel    AccessLevel   @default(OPEN)
  status         FileStatus    @default(PENDING)
  downloadCount  Int           @default(0)
  uploadedById   String?
  uploadedBy     User?         @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  datasetId      String?
  dataset        Dataset?      @relation("DatasetFiles", fields: [datasetId], references: [id], onDelete: SetNull)
  activityId     String?
  activity       Activity?     @relation("ActivityAttachments", fields: [activityId], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())
  completedAt    DateTime?

  publication Publication? @relation("PublicationPdf")
  media       MediaAsset[] @relation("MediaFile")

  @@index([datasetId])
  @@index([activityId])
  @@index([uploadedById])
}

// ─── Editorial workflow ─────────────────────────────────────────────────────

model Submission {
  id            String           @id @default(cuid())
  contentType   ContentType
  /// Polymorphic reference to the content record (no FK).
  contentId     String
  status        SubmissionStatus @default(PENDING)
  message       String?
  submittedById String
  submittedBy   User             @relation("Submitter", fields: [submittedById], references: [id], onDelete: Cascade)
  submittedAt   DateTime         @default(now())
  reviewedById  String?
  reviewedBy    User?            @relation("Reviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt    DateTime?
  reviewComment String?
  events        ReviewEvent[]

  @@index([contentType, contentId])
  @@index([status, submittedAt])
}

model ReviewEvent {
  id           String       @id @default(cuid())
  submissionId String
  submission   Submission   @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  action       ReviewAction
  actorId      String
  actor        User         @relation(fields: [actorId], references: [id], onDelete: Cascade)
  comment      String?
  createdAt    DateTime     @default(now())

  @@index([submissionId])
}

// ─── AI content ─────────────────────────────────────────────────────────────

model AIContent {
  id            String          @id @default(cuid())
  slug          String          @unique
  kind          AIContentKind
  title         String
  body          String
  audience      Audience
  language      String          @default("en")
  /// JSON array of { type, id } source references.
  sources       Json
  status        AIContentStatus @default(DRAFT)
  model         String
  promptVersion String?
  inputTokens   Int?
  outputTokens  Int?
  generatedById String?
  generatedBy   User?           @relation("AIGeneratedBy", fields: [generatedById], references: [id], onDelete: SetNull)
  reviewedById  String?
  reviewedBy    User?           @relation("AIReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt    DateTime?
  publishedAt   DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([status, kind])
}

// ─── Audit ──────────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([actorId])
  @@index([action])
}
